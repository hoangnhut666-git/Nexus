@using Nexus.Components.Admin.Shared

<div class="toast-container fixed bottom-6 right-6 flex flex-col gap-3 z-[9999] pointer-events-none" data-testid="toast-container">
    @foreach (var toast in Messages)
    {
        <div class="@GetToastClass(toast)" 
             data-testid="toast-item" 
             data-toast-type="@toast.Type.ToString().ToLower()">
             
            <i class="@GetIconClass(toast) text-base"></i>
            <div class="flex flex-col gap-0.5">
                <div class="text-xs font-bold" data-testid="toast-title">@toast.Title</div>
                <div class="text-xs text-text-secondary" data-testid="toast-description">@toast.Description</div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<AdminToastMessage> Messages { get; set; } = [];

    private static string GetToastClass(AdminToastMessage toast)
    {
        var border = toast.Type switch
        {
            AdminToastType.Success => "border-l-success",
            AdminToastType.Danger => "border-l-danger",
            AdminToastType.Warning => "border-l-warning",
            _ => "border-l-accent"
        };

        return $"toast show bg-bg-card border border-white/5 border-l-4 {border} text-text-primary px-5 py-4 rounded-lg shadow-xl flex items-center gap-3.5 w-max max-w-[400px]";
    }

    private static string GetIconClass(AdminToastMessage toast) => toast.Type switch
    {
        AdminToastType.Success => "fa-solid fa-circle-check text-success",
        AdminToastType.Danger => "fa-solid fa-circle-xmark text-danger",
        AdminToastType.Warning => "fa-solid fa-triangle-exclamation text-warning",
        _ => "fa-solid fa-circle-info text-accent"
    };
}