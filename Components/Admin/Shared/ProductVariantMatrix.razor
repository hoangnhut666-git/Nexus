@using Nexus.Services.Products.Models

<div class="bg-bg-card border border-border rounded-xl overflow-x-auto">
    <table class="w-full border-collapse min-w-[500px]">
        <thead>
            <tr>
                <th class="py-3 px-4 text-left text-xs uppercase tracking-wider text-text-muted border-b border-border"></th>
                @foreach (var col in ColumnValues)
                {
                    <th class="py-3 px-4 text-center text-xs uppercase tracking-wider text-text-muted border-b border-border font-semibold">@col.Value</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in RowValues)
            {
                <tr>
                    <td class="py-3 px-4 text-sm font-semibold text-text-primary border-b border-border">@row.Value</td>
                    @foreach (var col in ColumnValues)
                    {
                        var variant = FindVariant(row.Id, col.Id);
                        <td class="py-3 px-4 text-center border-b border-border align-middle">
                            @if (variant is null)
                            {
                                <button type="button"
                                        class="text-xs text-indigo-400 hover:text-indigo-300 font-semibold"
                                        @onclick="() => OnAdd.InvokeAsync((row.Id, col.Id))">
                                    + Add
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="w-full text-left hover:bg-overlay rounded-lg p-2 transition-colors"
                                        @onclick="() => OnEdit.InvokeAsync(variant)">
                                    <div class="text-xs text-text-muted font-mono">@variant.Sku</div>
                                    <div class="text-sm font-semibold text-text-primary">@MoneyFormatter.Format(variant.Price)</div>
                                    <div class="text-xs text-text-secondary">Stock: @variant.StockQuantity</div>
                                </button>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter]
    public IReadOnlyList<ProductOptionValueDto> RowValues { get; set; } = [];

    [Parameter]
    public IReadOnlyList<ProductOptionValueDto> ColumnValues { get; set; } = [];

    [Parameter]
    public IReadOnlyList<ProductVariantDto> Variants { get; set; } = [];

    [Parameter]
    public EventCallback<(int RowValueId, int ColValueId)> OnAdd { get; set; }

    [Parameter]
    public EventCallback<ProductVariantDto> OnEdit { get; set; }

    private ProductVariantDto? FindVariant(int rowValueId, int colValueId)
    {
        return Variants.FirstOrDefault(v =>
            v.OptionValueIds.Contains(rowValueId) && v.OptionValueIds.Contains(colValueId));
    }
}
