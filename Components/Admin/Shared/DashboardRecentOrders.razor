<div class="bg-bg-surface border border-white/5 rounded-xl overflow-hidden">
    <div class="flex justify-between items-center px-6 pt-6 pb-4">
        <div class="text-base font-bold text-text-primary">@Title</div>
        @if (!string.IsNullOrWhiteSpace(ActionLabel))
        {
            <a href="@ActionHref" class="text-accent text-[13px] font-semibold hover:underline">@ActionLabel</a>
        }
    </div>
    <div class="overflow-x-auto">
        <table class="w-full border-collapse">
            <thead>
                <tr>
                    @foreach (var header in Headers)
                    {
                        <th class="bg-white/[0.02] px-4 py-3 text-left text-xs uppercase text-text-muted border-b border-white/5 font-semibold">@header</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Orders)
                {
                    <tr class="hover:bg-white/[0.01]">
                        <td class="px-4 py-4 border-b border-white/5 text-sm">
                            <a href="#" class="font-semibold text-accent">@order.OrderId</a>
                        </td>
                        <td class="px-4 py-4 border-b border-white/5 text-sm text-text-primary font-medium">@order.Customer</td>
                        <td class="px-4 py-4 border-b border-white/5 text-sm text-text-secondary">@order.Products</td>
                        <td class="px-4 py-4 border-b border-white/5 text-sm font-bold text-text-primary">@order.Total</td>
                        <td class="px-4 py-4 border-b border-white/5 text-sm">
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold border @GetStatusClass(order.Status)">
                                @order.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "Recent Orders";

    [Parameter]
    public string ActionLabel { get; set; } = "View all orders";

    [Parameter]
    public string ActionHref { get; set; } = "#";

    [Parameter]
    public IReadOnlyList<string> Headers { get; set; } = ["Order ID", "Customer", "Products", "Total", "Status"];

    [Parameter]
    public IReadOnlyList<RecentOrderItem> Orders { get; set; } = DefaultOrders;

    public static IReadOnlyList<RecentOrderItem> DefaultOrders { get; } =
    [
        new("#NX-88392", "Alex Carter", "Watch Series 9 + 1 more", "$4,250.00", "Pending"),
        new("#NX-88391", "Sarah Kim", "NEXUS AirPods Pro 3", "$1,590.00", "Completed"),
        new("#NX-88385", "James Lee", "SmartPhone Z Fold", "$32,400.00", "Completed"),
    ];

    private static string GetStatusClass(string status) => status switch
    {
        "Completed" => "bg-success-bg text-success border-success/20",
        "Pending" => "bg-warning-bg text-warning border-warning/20",
        _ => "bg-white/5 text-text-secondary border-white/10"
    };

    public sealed record RecentOrderItem(
        string OrderId,
        string Customer,
        string Products,
        string Total,
        string Status);
}
