@using Nexus.Services.Products.Models

<div class="bg-bg-surface border border-white/5 rounded-xl overflow-hidden">
    <table class="w-full border-collapse">
        <thead>
            <tr>
                <th class="w-10 py-3 px-4 border-b border-white/5">
                    <input type="checkbox" class="custom-checkbox" @bind="@selectAll" @bind:after="OnSelectAllChanged" />
                </th>
                <th class="py-3 px-4 text-left text-xs uppercase tracking-wider text-text-muted border-b border-white/5">Variant</th>
                <th class="py-3 px-4 text-left text-xs uppercase tracking-wider text-text-muted border-b border-white/5">SKU</th>
                <th class="py-3 px-4 text-left text-xs uppercase tracking-wider text-text-muted border-b border-white/5">Price</th>
                <th class="py-3 px-4 text-left text-xs uppercase tracking-wider text-text-muted border-b border-white/5">Stock</th>
                <th class="py-3 px-4 text-left text-xs uppercase tracking-wider text-text-muted border-b border-white/5">Status</th>
                <th class="py-3 px-4 text-left text-xs uppercase tracking-wider text-text-muted border-b border-white/5">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Variants.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center py-8 text-text-muted text-sm">No variants yet.</td>
                </tr>
            }
            else
            {
                @foreach (var variant in Variants)
                {
                    <tr class="hover:bg-white/[0.01]" data-testid="admin-variant-row" data-name="@(string.IsNullOrWhiteSpace(variant.Sku) ? variant.OptionLabel : variant.Sku)">
                        <td class="py-3 px-4 border-b border-white/5">
                            <input type="checkbox" class="custom-checkbox" checked="@IsSelected(variant.Id)" @onchange="(e) => ToggleSelection(variant.Id, e)" />
                        </td>
                        <td class="py-3 px-4 border-b border-white/5 text-sm text-text-primary">@(string.IsNullOrWhiteSpace(variant.OptionLabel) ? "Default" : variant.OptionLabel)</td>
                        <td class="py-3 px-4 border-b border-white/5 text-xs font-mono text-text-secondary">@variant.Sku</td>
                        <td class="py-3 px-4 border-b border-white/5 text-sm font-semibold">@MoneyFormatter.Format(variant.Price)</td>
                        <td class="py-3 px-4 border-b border-white/5 text-sm">@variant.StockQuantity</td>
                        <td class="py-3 px-4 border-b border-white/5 text-sm">
                            <span class="@GetStatusClass(variant.IsActive)">@(variant.IsActive ? "Active" : "Hidden")</span>
                        </td>
                        <td class="py-3 px-4 border-b border-white/5">
                            <div class="flex gap-2">
                                <button type="button" class="text-text-secondary hover:text-indigo-400" title="Edit" data-testid="admin-variant-edit" @onclick="() => OnEdit.InvokeAsync(variant)">
                                    <i class="fa-regular fa-pen-to-square"></i>
                                </button>
                                <button type="button" class="text-text-secondary hover:text-rose-400" title="Delete" data-testid="admin-variant-delete" @onclick="() => OnDelete.InvokeAsync(variant)">
                                    <i class="fa-regular fa-trash-can"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter]
    public IReadOnlyList<ProductVariantDto> Variants { get; set; } = [];

    [Parameter]
    public EventCallback<ProductVariantDto> OnEdit { get; set; }

    [Parameter]
    public EventCallback<ProductVariantDto> OnDelete { get; set; }

    [Parameter]
    public EventCallback<HashSet<int>> SelectedIdsChanged { get; set; }

    private bool selectAll;
    private readonly HashSet<int> selectedIds = [];

    private static string GetStatusClass(bool isActive) =>
        isActive
            ? "inline-block px-2 py-1 rounded-full text-xs bg-emerald-500/10 text-emerald-500"
            : "inline-block px-2 py-1 rounded-full text-xs bg-white/5 text-text-secondary";

    private bool IsSelected(int id) => selectedIds.Contains(id);

    private async Task ToggleSelection(int id, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value && value;
        if (isChecked)
            selectedIds.Add(id);
        else
            selectedIds.Remove(id);

        selectAll = Variants.Count > 0 && Variants.All(v => selectedIds.Contains(v.Id));
        await SelectedIdsChanged.InvokeAsync(selectedIds);
    }

    private async Task OnSelectAllChanged()
    {
        selectedIds.Clear();
        if (selectAll)
        {
            foreach (var variant in Variants)
                selectedIds.Add(variant.Id);
        }

        await SelectedIdsChanged.InvokeAsync(selectedIds);
    }
}
