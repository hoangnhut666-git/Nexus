@page "/admin/orders/{OrderNumber}"
@rendermode InteractiveServer

@using System.Security.Claims
@using Nexus.Components.Admin.Shared
@using Nexus.Data.Entities
@using Nexus.Services.Orders
@using Nexus.Services.Orders.Models

@inject IOrderService OrderService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<CascadingValue Name="AdminPageTitle" Value="@("Order Details")">
    @if (isLoading)
    {
        <div class="text-text-muted py-16 text-center">Loading order...</div>
    }
    else if (order is null)
    {
        <div class="bg-bg-surface border border-white/5 rounded-xl p-16 text-center">
            <i class="fa-solid fa-box-open text-4xl text-text-muted mb-4"></i>
            <h1 class="text-xl font-bold mb-2">Order not found</h1>
            <a href="/admin/orders" class="text-accent font-semibold hover:underline" data-testid="admin-order-back">
                <i class="fa-solid fa-arrow-left mr-2"></i> Back to orders
            </a>
        </div>
    }
    else
    {
        <div class="mb-6 flex items-center justify-between flex-wrap gap-4" data-testid="admin-order-detail">
            <div>
                <a href="/admin/orders" class="text-text-muted hover:text-text-primary text-sm" data-testid="admin-order-back">
                    <i class="fa-solid fa-arrow-left mr-1"></i> Back to orders
                </a>
                <div class="flex items-center gap-3 mt-2">
                    <h1 class="text-2xl font-extrabold">@order.OrderNumber</h1>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold @StatusClass(order.Status)">@order.Status</span>
                </div>
                <p class="text-text-secondary text-sm mt-1">Placed @order.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</p>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 flex flex-col gap-6">
                <div class="bg-bg-surface border border-white/5 rounded-xl p-6">
                    <div class="text-base font-bold pb-4 mb-4 border-b border-white/5">Items</div>
                    <div class="flex flex-col">
                        @foreach (var item in order.Items)
                        {
                            <div class="flex items-center justify-between py-3 border-b border-dashed border-white/5 last:border-b-0">
                                <div class="min-w-0 mr-3">
                                    <div class="font-semibold text-text-primary truncate">@item.ProductName</div>
                                    <div class="text-xs text-text-muted mt-0.5 flex flex-wrap gap-x-3">
                                        @if (!string.IsNullOrWhiteSpace(item.VariantLabel))
                                        {
                                            <span>@item.VariantLabel</span>
                                        }
                                        <span>SKU: @item.Sku</span>
                                        <span>@MoneyFormatter.Format(item.UnitPrice) x @item.Quantity</span>
                                    </div>
                                </div>
                                <div class="text-base font-bold text-accent whitespace-nowrap">@MoneyFormatter.Format(item.LineTotal)</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="bg-bg-surface border border-white/5 rounded-xl p-6">
                    <div class="text-base font-bold pb-4 mb-4 border-b border-white/5">Customer & Shipping</div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                        <div>
                            <div class="text-text-muted text-xs uppercase mb-1">Customer</div>
                            <div class="text-text-primary font-semibold">@(string.IsNullOrWhiteSpace(order.CustomerName) ? "—" : order.CustomerName)</div>
                            <div class="text-text-secondary">@order.CustomerEmail</div>
                        </div>
                        <div>
                            <div class="text-text-muted text-xs uppercase mb-1">Ship to</div>
                            <div class="text-text-primary font-semibold">@order.ShipFullName</div>
                            <div class="text-text-secondary">@order.ShipPhone</div>
                            <div class="text-text-secondary">@order.ShipStreet</div>
                            <div class="text-text-secondary">
                                @order.ShipState@(string.IsNullOrWhiteSpace(order.ShipState) || string.IsNullOrWhiteSpace(order.ShipCity) ? "" : ", ")@order.ShipCity
                            </div>
                            <div class="text-text-secondary">@order.ShipCountry</div>
                        </div>
                    </div>
                </div>

                <div class="bg-bg-surface border border-white/5 rounded-xl p-6">
                    <div class="text-base font-bold pb-4 mb-4 border-b border-white/5">Activity & Notes</div>

                    <div class="flex gap-2 mb-5">
                        <input type="text"
                               placeholder="Add an internal note..."
                               class="flex-1 bg-bg-card border border-white/5 py-2.5 px-4 rounded-lg text-text-primary text-sm outline-none focus:border-indigo-500/40"
                               value="@noteText"
                               data-testid="admin-order-note-input"
                               @oninput="@(e => noteText = e.Value?.ToString() ?? string.Empty)" />
                        <button type="button"
                                class="bg-bg-card border border-white/5 text-text-primary py-2.5 px-4 rounded-lg text-sm font-semibold hover:border-white/10 disabled:opacity-40"
                                disabled="@(string.IsNullOrWhiteSpace(noteText) || isBusy)"
                                data-testid="admin-order-add-note"
                                @onclick="AddNoteAsync">Add note</button>
                    </div>

                    @if (order.Events.Count == 0)
                    {
                        <div class="text-text-muted text-sm">No activity yet.</div>
                    }
                    else
                    {
                        <div class="flex flex-col gap-3">
                            @foreach (var ev in order.Events)
                            {
                                <div class="flex gap-3 items-start">
                                    <div class="mt-1 w-7 h-7 rounded-full bg-white/5 flex items-center justify-center text-xs text-text-secondary">
                                        <i class="@EventIcon(ev.Type)"></i>
                                    </div>
                                    <div class="flex-1">
                                        <div class="text-sm text-text-primary">@EventText(ev)</div>
                                        @if (!string.IsNullOrWhiteSpace(ev.Message))
                                        {
                                            <div class="text-sm text-text-secondary mt-0.5">@ev.Message</div>
                                        }
                                        <div class="text-xs text-text-muted mt-0.5">@ev.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="flex flex-col gap-6">
                <div class="bg-bg-surface border border-white/5 rounded-xl p-6">
                    <div class="text-base font-bold pb-4 mb-4 border-b border-white/5">Summary</div>
                    <div class="flex justify-between text-sm text-text-secondary mb-3">
                        <span>Subtotal</span><span class="text-text-primary font-medium">@MoneyFormatter.Format(order.Subtotal)</span>
                    </div>
                    <div class="flex justify-between text-sm text-text-secondary mb-3">
                        <span>Shipping</span><span class="text-text-primary font-medium">@(order.ShippingFee == 0 ? "Free" : MoneyFormatter.Format(order.ShippingFee))</span>
                    </div>
                    <div class="flex justify-between text-sm text-text-secondary mb-3">
                        <span>Tax</span><span class="text-text-primary font-medium">@MoneyFormatter.Format(order.TaxAmount)</span>
                    </div>
                    <div class="flex justify-between items-center border-t border-dashed border-white/5 pt-4 mt-2">
                        <span class="text-sm font-semibold">Total</span>
                        <span class="text-xl font-extrabold text-accent">@MoneyFormatter.Format(order.Total)</span>
                    </div>
                    <div class="flex justify-between text-sm text-text-secondary mt-4 pt-4 border-t border-white/5">
                        <span>Payment</span>
                        <span class="text-text-primary font-medium">@PaymentLabel(order.PaymentMethod) · @order.PaymentStatus</span>
                    </div>
                </div>

                <div class="bg-bg-surface border border-white/5 rounded-xl p-6">
                    <div class="text-base font-bold pb-4 mb-4 border-b border-white/5">Update Status</div>

                    @if (allowedNext.Count == 0 && !canCancel)
                    {
                        <div class="text-text-muted text-sm">No further actions available for a @order.Status order.</div>
                    }
                    else
                    {
                        @if (allowedNext.Count > 0)
                        {
                            <label class="text-xs text-text-muted uppercase mb-1 block">Advance to</label>
                            <select class="w-full bg-bg-card border border-white/5 text-text-primary py-2.5 px-4 rounded-lg text-sm outline-none cursor-pointer mb-3 focus:border-indigo-500/40"
                                    value="@selectedNext"
                                    data-testid="admin-order-status-select"
                                    @onchange="@(e => selectedNext = e.Value?.ToString() ?? string.Empty)">
                                @foreach (var status in allowedNext)
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                            <button type="button"
                                    class="w-full bg-gradient-to-r from-indigo-500 to-purple-500 text-white py-2.5 px-4 rounded-lg text-sm font-semibold shadow-[0_4px_15px_rgba(99,102,241,0.2)] transition-all duration-300 hover:-translate-y-0.5 disabled:opacity-40 disabled:hover:translate-y-0 mb-2"
                                    disabled="@isBusy"
                                    data-testid="admin-order-apply-status"
                                    @onclick="UpdateStatusAsync">
                                <i class="fa-solid fa-arrow-right mr-1"></i> Apply
                            </button>
                        }

                        @if (canCancel)
                        {
                            <button type="button"
                                    class="w-full bg-danger-bg text-danger border border-danger/20 py-2.5 px-4 rounded-lg text-sm font-semibold transition-all duration-300 hover:bg-danger/10 disabled:opacity-40"
                                    disabled="@isBusy"
                                    data-testid="admin-order-cancel"
                                    @onclick="CancelAsync">
                                <i class="fa-solid fa-ban mr-1"></i> Cancel order (restores stock)
                            </button>
                        }
                    }
                </div>
            </div>
        </div>
    }
</CascadingValue>

<AdminToast Messages="@toasts" />

@code {
    [Parameter]
    public string OrderNumber { get; set; } = string.Empty;

    private AdminOrderDetailDto? order;
    private bool isLoading = true;
    private bool isBusy;

    private IReadOnlyList<OrderStatus> allowedNext = [];
    private bool canCancel;
    private string selectedNext = string.Empty;
    private string noteText = string.Empty;

    private string? adminUserId;

    private readonly List<AdminToastMessage> toasts = [];

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        adminUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        await LoadOrderAsync();
    }

    private async Task LoadOrderAsync()
    {
        isLoading = true;
        order = await OrderService.GetByNumberAsync(OrderNumber);

        if (order is not null)
        {
            allowedNext = OrderStatusRules.AllowedNext(order.Status);
            canCancel = OrderStatusRules.CanCancel(order.Status);
            selectedNext = allowedNext.FirstOrDefault().ToString();
        }

        isLoading = false;
    }

    private async Task UpdateStatusAsync()
    {
        if (order is null || string.IsNullOrWhiteSpace(adminUserId))
            return;

        if (!Enum.TryParse<OrderStatus>(selectedNext, out var next))
            return;

        isBusy = true;
        var result = await OrderService.UpdateStatusAsync(order.Id, next, adminUserId, null);
        isBusy = false;

        if (!result.Success)
        {
            ShowToast("Update failed", result.Error ?? "Could not update status.", AdminToastType.Danger);
            return;
        }

        ShowToast("Status updated", $"Order is now {next}.", AdminToastType.Success);
        await LoadOrderAsync();
    }

    private async Task CancelAsync()
    {
        if (order is null || string.IsNullOrWhiteSpace(adminUserId))
            return;

        isBusy = true;
        var result = await OrderService.CancelAsync(order.Id, adminUserId, null);
        isBusy = false;

        if (!result.Success)
        {
            ShowToast("Cancel failed", result.Error ?? "Could not cancel order.", AdminToastType.Danger);
            return;
        }

        ShowToast("Order cancelled", "Stock has been restored.", AdminToastType.Warning);
        await LoadOrderAsync();
    }

    private async Task AddNoteAsync()
    {
        if (order is null || string.IsNullOrWhiteSpace(adminUserId) || string.IsNullOrWhiteSpace(noteText))
            return;

        isBusy = true;
        var result = await OrderService.AddNoteAsync(order.Id, adminUserId, noteText);
        isBusy = false;

        if (!result.Success)
        {
            ShowToast("Note failed", result.Error ?? "Could not add note.", AdminToastType.Danger);
            return;
        }

        noteText = string.Empty;
        await LoadOrderAsync();
    }

    private void ShowToast(string title, string description, AdminToastType type)
    {
        var toast = new AdminToastMessage { Title = title, Description = description, Type = type };
        toasts.Add(toast);
        _ = RemoveToastAfterDelayAsync(toast.Id);
    }

    private async Task RemoveToastAfterDelayAsync(Guid toastId)
    {
        await Task.Delay(3000);
        var toast = toasts.FirstOrDefault(t => t.Id == toastId);
        if (toast is not null)
            toasts.Remove(toast);

        await InvokeAsync(StateHasChanged);
    }

    private static string EventText(OrderEventDto ev) => ev.Type switch
    {
        OrderEventType.StatusChanged => ev.OldStatus is null
            ? $"Status set to {ev.NewStatus}"
            : $"Status changed from {ev.OldStatus} to {ev.NewStatus}",
        OrderEventType.NoteAdded => "Note added",
        _ => ev.Type.ToString()
    };

    private static string EventIcon(OrderEventType type) => type switch
    {
        OrderEventType.StatusChanged => "fa-solid fa-arrow-right-arrow-left",
        OrderEventType.NoteAdded => "fa-solid fa-note-sticky",
        _ => "fa-solid fa-circle-info"
    };

    private static string PaymentLabel(PaymentMethod method) => method switch
    {
        PaymentMethod.Cod => "Cash on Delivery",
        PaymentMethod.PayPal => "PayPal",
        _ => method.ToString()
    };

    private static string StatusClass(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "bg-amber-500/15 text-amber-400",
        OrderStatus.Paid => "bg-emerald-500/15 text-emerald-400",
        OrderStatus.Processing => "bg-indigo-500/15 text-indigo-400",
        OrderStatus.Shipped => "bg-sky-500/15 text-sky-400",
        OrderStatus.Delivered => "bg-emerald-500/15 text-emerald-400",
        OrderStatus.Cancelled => "bg-danger-bg text-danger",
        _ => "bg-white/10 text-text-secondary"
    };
}
