@inherits LayoutComponentBase

<main class="w-full flex min-h-screen overflow-hidden">
    <section class="hidden lg:flex lg:w-1/2 bg-bg-surface border-r border-white/5 flex-col justify-between p-16 relative overflow-hidden">
        <div class="absolute -top-[10%] -left-[10%] w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(99,102,241,0.12)_0%,rgba(0,0,0,0)_70%)] z-0 pointer-events-none animate-pulse" style="animation-duration: 8s;"></div>
        <div class="absolute -bottom-[15%] -right-[5%] w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(0,242,254,0.06)_0%,rgba(0,0,0,0)_70%)] z-0 pointer-events-none animate-pulse" style="animation-duration: 12s;"></div>

        <div class="z-10">
            <a href="/" class="text-[24px] font-extrabold tracking-[1.5px] bg-gradient-to-r from-white to-slate-400 bg-clip-text text-transparent flex items-center gap-2.5">
                <i class="fa-solid fa-cube bg-gradient-to-r from-indigo-500 to-purple-500 bg-clip-text text-transparent"></i>NEXUS.
            </a>
        </div>

        <div class="z-10 my-auto relative w-full max-w-[420px] mx-auto">
            <div class="bg-bg-card/45 backdrop-blur-xl border border-white/10 rounded-2xl p-6 shadow-[0_20px_50px_rgba(0,0,0,0.5)] transition-all duration-500 hover:scale-[1.03] hover:border-indigo-500/30 group">
                <div class="flex justify-between items-center mb-6">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-red-500/70"></span>
                        <span class="w-3 h-3 rounded-full bg-yellow-500/70"></span>
                        <span class="w-3 h-3 rounded-full bg-green-500/70"></span>
                    </div>
                    <div class="text-[10px] text-text-muted uppercase font-bold tracking-widest bg-white/5 py-1 px-2.5 rounded-full">NEXUS System</div>
                </div>

                <div class="space-y-4">
                    <div>
                        <div class="text-xs text-text-secondary mb-1">Revenue this month</div>
                        <div class="text-3xl font-extrabold tracking-tight bg-gradient-to-r from-white to-slate-200 bg-clip-text text-transparent flex items-baseline gap-2">
                            $142,384.50
                            <span class="text-xs font-semibold text-emerald-500 bg-emerald-500/10 px-2 py-0.5 rounded-md flex items-center gap-0.5">
                                <i class="fa-solid fa-caret-up"></i> 12.4%
                            </span>
                        </div>
                    </div>

                    <div class="h-28 flex items-end gap-3.5 pt-4 border-t border-white/5">
                        <div class="w-full bg-white/5 hover:bg-indigo-500/35 transition-all duration-300 rounded-md h-[40%]"></div>
                        <div class="w-full bg-white/5 hover:bg-indigo-500/35 transition-all duration-300 rounded-md h-[65%]"></div>
                        <div class="w-full bg-gradient-to-t from-indigo-500 to-purple-500 rounded-md h-[90%] shadow-[0_0_15px_rgba(99,102,241,0.3)]"></div>
                        <div class="w-full bg-white/5 hover:bg-indigo-500/35 transition-all duration-300 rounded-md h-[50%]"></div>
                        <div class="w-full bg-white/5 hover:bg-indigo-500/35 transition-all duration-300 rounded-md h-[75%]"></div>
                    </div>
                </div>
            </div>

            <div class="absolute -top-8 -right-8 bg-[#171520]/75 backdrop-blur-xl border border-white/10 p-3.5 rounded-2xl flex items-center gap-3.5 shadow-lg animate-bounce" style="animation-duration: 4s;">
                <div class="w-9 h-9 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400">
                    <i class="fa-solid fa-bolt text-sm"></i>
                </div>
                <div>
                    <div class="text-[10px] text-text-muted font-bold uppercase tracking-wider">Hệ thống</div>
                    <div class="text-xs font-bold text-text-primary">Độ trễ: 12ms</div>
                </div>
            </div>

            <div class="absolute -bottom-8 -left-8 bg-[#171520]/75 backdrop-blur-xl border border-white/10 p-3.5 rounded-2xl flex items-center gap-3.5 shadow-lg animate-bounce" style="animation-duration: 6s;">
                <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
                    <i class="fa-solid fa-shield-halved text-sm"></i>
                </div>
                <div>
                    <div class="text-[10px] text-text-muted font-bold uppercase tracking-wider">Bảo mật</div>
                    <div class="text-xs font-bold text-text-primary">Mã hóa AES-256</div>
                </div>
            </div>
        </div>

        <div class="z-10 max-w-sm">
            <p class="text-sm text-text-secondary leading-relaxed">
                Trải nghiệm trình quản trị thông minh hàng đầu. Tối ưu hóa quy trình, trực quan hóa dữ liệu và vận hành hệ thống bán hàng chỉ bằng một chạm.
            </p>
        </div>
    </section>

    <section class="w-full lg:w-1/2 flex flex-col justify-center items-center p-6 sm:p-12 md:p-24 relative z-10 bg-bg-base overflow-y-auto overflow-x-hidden">
        <div class="absolute -top-[10%] -right-[5%] w-[450px] h-[450px] bg-[radial-gradient(circle,rgba(168,85,247,0.06)_0%,rgba(0,0,0,0)_70%)] z-[-1] pointer-events-none"></div>
        @Body
    </section>
</main>

<div id="blazor-error-ui" data-nosnippet class="fixed bottom-0 left-0 right-0 bg-danger text-white p-4 hidden">
    An unhandled error has occurred.
    <a href="." class="underline ml-2">Reload</a>
</div>
