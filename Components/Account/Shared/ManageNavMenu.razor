@using Microsoft.AspNetCore.Identity
@using Nexus.Data

@inject SignInManager<ApplicationUser> SignInManager

<nav class="flex flex-col gap-1">
    <NavLink class="manage-nav-link" href="Account/Manage" Match="NavLinkMatch.All">
        <i class="fa-regular fa-user w-4 text-center"></i><span>Profile</span>
    </NavLink>
    <NavLink class="manage-nav-link" href="Account/Manage/Addresses">
        <i class="fa-solid fa-location-dot w-4 text-center"></i><span>Addresses</span>
    </NavLink>
    <NavLink class="manage-nav-link" href="Account/Manage/Email">
        <i class="fa-regular fa-envelope w-4 text-center"></i><span>Email</span>
    </NavLink>
    <NavLink class="manage-nav-link" href="Account/Manage/ChangePassword">
        <i class="fa-solid fa-key w-4 text-center"></i><span>Password</span>
    </NavLink>
    @if (hasExternalLogins)
    {
        <NavLink class="manage-nav-link" href="Account/Manage/ExternalLogins">
            <i class="fa-solid fa-link w-4 text-center"></i><span>External logins</span>
        </NavLink>
    }
    <NavLink class="manage-nav-link" href="Account/Manage/TwoFactorAuthentication">
        <i class="fa-solid fa-shield-halved w-4 text-center"></i><span>Two-factor auth</span>
    </NavLink>
    <NavLink class="manage-nav-link" href="Account/Manage/Passkeys">
        <i class="fa-solid fa-fingerprint w-4 text-center"></i><span>Passkeys</span>
    </NavLink>
    <NavLink class="manage-nav-link" href="Account/Manage/PersonalData">
        <i class="fa-solid fa-database w-4 text-center"></i><span>Personal data</span>
    </NavLink>
</nav>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
