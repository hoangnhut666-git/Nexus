@page "/Account/ResetPasswordConfirmation"
<PageTitle>Reset password confirmation</PageTitle>

<div data-testid="reset-password-confirmation-page">
    <h1>Reset password confirmation</h1>
    <p role="alert">
        Your password has been reset. Please <a href="Account/Login" data-testid="reset-password-login-link">click here to log in</a>.
    </p>
</div>
