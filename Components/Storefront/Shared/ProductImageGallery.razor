@using Nexus.Services.Products.Models

<div class="w-full h-[400px] sm:h-[480px] rounded-2xl bg-bg-surface border border-border flex items-center justify-center p-8 overflow-hidden relative group"
     data-testid="pdp-gallery">
    @if (!string.IsNullOrWhiteSpace(ActiveImageUrl))
    {
        <img src="@ActiveImageUrl" alt="@ProductName" class="max-w-full max-h-full object-contain transition-transform duration-500 group-hover:scale-105" />
    }
    else
    {
        <i class="fa-solid fa-image text-5xl text-text-muted"></i>
    }

    @if (InStock)
    {
        <div class="absolute top-4 left-4 bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> In stock
        </div>
    }
    else if (ShowAvailability)
    {
        <div class="absolute top-4 left-4 bg-danger-bg border border-danger/30 text-danger px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-danger"></span> Out of stock
        </div>
    }
</div>

@if (Images.Count > 1)
{
    <div class="flex gap-4 mt-4">
        @foreach (var image in Images)
        {
            <button type="button"
                    class="@GetThumbClass(image.ImageUrl)"
                    data-testid="pdp-gallery-thumb"
                    @onclick="() => SelectImage(image.ImageUrl)">
                <img src="@image.ImageUrl" alt="" class="w-full h-full object-cover" />
            </button>
        }
    </div>
}

@code {
    [Parameter]
    public string ProductName { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<ProductImageDto> Images { get; set; } = [];

    [Parameter]
    public string? VariantImageUrl { get; set; }

    [Parameter]
    public bool InStock { get; set; }

    [Parameter]
    public bool ShowAvailability { get; set; }

    private string? selectedImageUrl;

    private string? ActiveImageUrl =>
        VariantImageUrl
        ?? selectedImageUrl
        ?? Images.FirstOrDefault()?.ImageUrl;

    protected override void OnParametersSet()
    {
        if (selectedImageUrl is null && Images.Count > 0)
            selectedImageUrl = Images[0].ImageUrl;
    }

    private void SelectImage(string imageUrl) => selectedImageUrl = imageUrl;

    private string GetThumbClass(string imageUrl)
    {
        var isActive = string.Equals(ActiveImageUrl, imageUrl, StringComparison.OrdinalIgnoreCase);
        return isActive
            ? "w-20 h-20 rounded-xl bg-bg-surface border-2 border-indigo-500 overflow-hidden flex items-center justify-center cursor-pointer transition-all duration-300"
            : "w-20 h-20 rounded-xl bg-bg-surface border-2 border-border overflow-hidden flex items-center justify-center cursor-pointer opacity-60 hover:opacity-100 transition-all duration-300";
    }
}
