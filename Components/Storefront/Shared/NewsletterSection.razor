<section class="py-20 bg-bg-surface border-t border-border text-center">
    <div class="max-w-xl mx-auto px-6">
        <h2 class="text-3xl font-bold">Join the NEXUS Club</h2>
        <p class="text-text-secondary mt-3 mb-8">Subscribe to never miss exclusive drops and get a $10 voucher for your first order.</p>
        @if (subscribed)
        {
            <p class="text-success font-medium" data-testid="newsletter-success">Thank you for subscribing!</p>
        }
        else
        {
            <form class="flex gap-3 bg-overlay border border-border p-1.5 rounded-lg" @onsubmit="HandleSubmit" @onsubmit:preventDefault data-testid="newsletter-form">
                <input type="email"
                       @bind="email"
                       placeholder="Enter your email..."
                       class="flex-1 bg-transparent border-none px-4 py-3 text-sm text-text-primary focus:outline-none"
                       required
                       data-testid="newsletter-email-input" />
                <button type="submit" class="bg-white text-black px-6 py-3 font-semibold text-sm rounded-lg hover:bg-gradient-to-r hover:from-indigo-500 hover:to-purple-500 hover:text-white transition" data-testid="newsletter-submit-button">Subscribe</button>
            </form>
        }
    </div>
</section>

@code {
    private string email = string.Empty;
    private bool subscribed;

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(email))
        {
            subscribed = true;
        }
    }
}
