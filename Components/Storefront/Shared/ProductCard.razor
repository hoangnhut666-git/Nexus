@using Nexus.Services.Products.Models

<div class="bg-bg-surface border border-white/5 rounded-2xl overflow-hidden hover:border-white/15 hover:-translate-y-1 hover:shadow-2xl transition group" data-testid="product-card" data-slug="@Product.Slug">
    <div class="relative bg-[#14131a] aspect-square flex items-center justify-center overflow-hidden">
        @if (!string.IsNullOrWhiteSpace(Product.ThumbnailUrl))
        {
            <img src="@Product.ThumbnailUrl" alt="@Product.Name" class="w-full h-full object-cover transition duration-500 group-hover:scale-105" />
        }
        else
        {
            <i class="fa-solid fa-image text-4xl text-text-muted"></i>
        }
        @if (!Product.InStock)
        {
            <span class="absolute top-3 left-3 z-10 bg-danger-bg border border-danger/30 text-danger text-[10px] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full">
                Out of stock
            </span>
        }
        <button type="button" class="absolute top-3 right-3 z-10 bg-bg-base/60 backdrop-blur-8 border border-white/5 text-text-secondary w-9 h-9 rounded-full flex items-center justify-center hover:bg-white hover:text-red-500 transition">
            <i class="fa-regular fa-heart"></i>
        </button>
        @if (Product.InStock)
        {
            <div class="absolute bottom-0 left-0 w-full p-5 bg-gradient-to-t from-bg-base/90 to-transparent translate-y-full group-hover:translate-y-0 transition z-10">
                @if (Product.HasOptions)
                {
                    <a href="@ProductUrl"
                       data-testid="product-card-choose-options"
                       class="bg-white text-black w-full py-2.5 rounded-lg font-semibold text-sm flex items-center justify-center gap-2 hover:bg-accent hover:text-white transition shadow-lg">
                        <i class="fa-solid fa-sliders"></i> Choose options
                    </a>
                }
                else
                {
                    <button type="button"
                            class="bg-white text-black w-full py-2.5 rounded-lg font-semibold text-sm flex items-center justify-center gap-2 hover:bg-accent hover:text-white transition shadow-lg disabled:opacity-60"
                            disabled="@isAdding"
                            data-testid="product-card-add-to-cart"
                            @onclick="HandleQuickAdd">
                        <i class="fa-solid @(isAdding ? "fa-spinner fa-spin" : "fa-cart-plus")"></i> @(isAdding ? "Adding..." : "Add to cart")
                    </button>
                }
            </div>
        }
    </div>
    <div class="p-5">
        <div class="text-text-muted text-xs uppercase tracking-wide">@Product.CategoryName</div>
        <h3 class="font-semibold text-base truncate">
            <a href="@ProductUrl" class="hover:text-accent" data-testid="product-card-name">@Product.Name</a>
        </h3>
        <div class="flex justify-between items-center mt-2">
            <div>
                @if (Product.HasOptions)
                {
                    <span class="text-text-muted text-xs mr-1">From</span>
                }
                <span class="font-bold text-lg">@MoneyFormatter.Format(Product.MinPrice)</span>
            </div>
            @if (Product.InStock)
            {
                <div class="text-emerald-400 text-xs flex items-center gap-1">
                    <i class="fa-solid fa-circle text-[6px]"></i>
                    <span class="text-text-secondary font-medium">In stock</span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public CatalogProductListItemDto Product { get; set; } = default!;

    [Parameter]
    public EventCallback<CatalogProductListItemDto> OnQuickAdd { get; set; }

    private bool isAdding;

    private string ProductUrl => $"/products/{Product.Slug}";

    private async Task HandleQuickAdd()
    {
        if (isAdding || !OnQuickAdd.HasDelegate)
            return;

        isAdding = true;
        await OnQuickAdd.InvokeAsync(Product);
        isAdding = false;
    }
}
