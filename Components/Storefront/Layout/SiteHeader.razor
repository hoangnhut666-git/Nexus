@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Nexus.Services.Cart
@using Nexus.Services.Categories.Models

@implements IDisposable

@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICartService CartService
@inject CartState CartState

<header class="sticky top-0 z-50 bg-bg-surface/85 backdrop-blur-20 border-b border-white/5 transition-all">
    <div class="max-w-7xl mx-auto px-6 flex items-center justify-between h-20">
        <a href="/" class="text-2xl font-extrabold tracking-wide flex items-center gap-2 bg-gradient-to-r from-white to-text-secondary bg-clip-text text-transparent">
            <i class="fa-solid fa-cube text-transparent bg-clip-text bg-gradient-to-r from-indigo-500 to-purple-500"></i>NEXUS.
        </a>

        <nav class="hidden md:block">
            <ul class="flex gap-9 text-sm font-medium text-text-secondary">
                <li><a href="/" class="text-text-primary relative after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:bg-gradient-to-r after:from-indigo-500 after:to-purple-500 hover:text-text-primary transition">Home</a></li>
                <li><a href="/products" class="hover:text-text-primary transition relative after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-0 hover:after:w-full after:bg-gradient-to-r after:from-indigo-500 after:to-purple-500 after:transition-all">Shop</a></li>
                <li><a href="#" class="hover:text-text-primary transition relative after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-0 hover:after:w-full after:bg-gradient-to-r after:from-indigo-500 after:to-purple-500 after:transition-all">Collections</a></li>
                <li><a href="#" class="hover:text-text-primary transition relative after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-0 hover:after:w-full after:bg-gradient-to-r after:from-indigo-500 after:to-purple-500 after:transition-all">Limited Offers</a></li>
                <li><a href="#" class="hover:text-text-primary transition relative after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-0 hover:after:w-full after:bg-gradient-to-r after:from-indigo-500 after:to-purple-500 after:transition-all">Support</a></li>
            </ul>
        </nav>

        <div class="flex items-center gap-5">
            <div class="relative hidden lg:flex items-center">
                <i class="fa-solid fa-magnifying-glass absolute left-3 text-text-muted text-sm"></i>
                <input type="text"
                       placeholder="Search products..."
                       class="bg-white/5 border border-white/5 rounded-lg py-2.5 pl-10 pr-4 text-sm text-text-primary w-52 focus:w-64 focus:outline-none focus:border-indigo-500/40 focus:bg-white/10 transition-all shadow-[0_0_15px_rgba(99,102,241,0.15)]"
                       value="@searchTerm"
                       @oninput="OnSearchInput"
                       @onkeydown="OnSearchKeyDown" />
            </div>
            <button type="button" class="text-text-secondary hover:text-text-primary p-2 rounded-full hover:bg-white/5 transition" title="Wishlist">
                <i class="fa-regular fa-heart text-lg"></i>
            </button>
            <a href="/cart" class="text-text-secondary hover:text-text-primary p-2 rounded-full hover:bg-white/5 transition relative" title="Cart">
                <i class="fa-solid fa-bag-shopping text-lg"></i>
                @if (CartState.Count > 0)
                {
                    <span class="absolute -top-1 -right-1 bg-gradient-to-r from-indigo-500 to-purple-500 text-white text-[10px] font-bold min-w-[18px] h-[18px] px-1 rounded-full flex items-center justify-center border-2 border-bg-surface">@CartState.Count</span>
                }
            </a>
            <AuthorizeView>
                <Authorized>
                    <div class="relative">
                        <button type="button"
                                @onclick="ToggleAccountMenu"
                                class="text-text-secondary hover:text-text-primary p-2 rounded-full hover:bg-white/5 transition @(accountMenuOpen ? "bg-white/5 text-text-primary" : "")"
                                title="Account"
                                aria-haspopup="true"
                                aria-expanded="@accountMenuOpen">
                            <i class="fa-regular fa-user text-lg"></i>
                        </button>

                        @if (accountMenuOpen)
                        {
                            <div class="fixed inset-0 z-40" @onclick="CloseAccountMenu"></div>

                            <div class="absolute right-0 mt-2 w-60 z-50 origin-top-right rounded-xl border border-white/10 bg-bg-surface/95 backdrop-blur-20 shadow-[0_10px_40px_rgba(0,0,0,0.45)] py-2">
                                <div class="px-4 py-2 border-b border-white/5">
                                    <p class="text-xs text-text-muted">Signed in as</p>
                                    <p class="text-sm font-semibold text-text-primary truncate">@(context.User.Identity?.Name)</p>
                                </div>

                                <a href="/orders"
                                   @onclick="CloseAccountMenu"
                                   class="flex items-center gap-3 px-4 py-2.5 text-sm text-text-secondary hover:text-text-primary hover:bg-white/5 transition">
                                    <i class="fa-solid fa-box w-4 text-center"></i>
                                    <span>Order History</span>
                                </a>
                                <a href="Account/Manage"
                                   @onclick="CloseAccountMenu"
                                   class="flex items-center gap-3 px-4 py-2.5 text-sm text-text-secondary hover:text-text-primary hover:bg-white/5 transition">
                                    <i class="fa-solid fa-gear w-4 text-center"></i>
                                    <span>Account Management</span>
                                </a>

                                <div class="my-1 border-t border-white/5"></div>

                                <form action="Account/Logout" method="post" class="px-2">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="ReturnUrl" value="" />
                                    <button type="submit"
                                            class="flex w-full items-center gap-3 px-2 py-2 rounded-lg text-sm text-rose-400 hover:text-rose-300 hover:bg-rose-500/10 transition">
                                        <i class="fa-solid fa-right-from-bracket w-4 text-center"></i>
                                        <span>Logout</span>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a href="Account/Login" class="text-text-secondary hover:text-text-primary p-2 rounded-full hover:bg-white/5 transition" title="Account">
                        <i class="fa-regular fa-user text-lg"></i>
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>

@code {
    private string searchTerm = string.Empty;
    private bool accountMenuOpen;

    private void ToggleAccountMenu() => accountMenuOpen = !accountMenuOpen;

    private void CloseAccountMenu() => accountMenuOpen = false;

    protected override async Task OnInitializedAsync()
    {
        CartState.OnChange += HandleCartChanged;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (!string.IsNullOrWhiteSpace(userId))
            CartState.SetCount(await CartService.GetItemCountAsync(userId));
    }

    private async void HandleCartChanged() =>
        await InvokeAsync(StateHasChanged);

    public void Dispose() =>
        CartState.OnChange -= HandleCartChanged;

    private void OnSearchInput(ChangeEventArgs args) =>
        searchTerm = args.Value?.ToString() ?? string.Empty;

    private void OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Enter")
            return;

        var term = searchTerm.Trim();
        Navigation.NavigateTo(string.IsNullOrWhiteSpace(term)
            ? "/products"
            : $"/products?search={Uri.EscapeDataString(term)}");
    }
}
