@page "/cart"
@layout StorefrontLayout
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Nexus.Data
@using Nexus.Services.Cart
@using Nexus.Services.Cart.Models

@attribute [Authorize(Roles = IdentitySeedData.CustomerRole)]

@inject ICartService CartService
@inject CartState CartState
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Your Cart — NEXUS</PageTitle>

<div class="max-w-7xl mx-auto px-6 py-10">
    <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight mb-2">Your Cart</h1>
        <p class="text-text-secondary text-sm">Review your items before checkout</p>
    </div>

    @if (isLoading)
    {
        <div class="text-text-muted py-16">Loading cart...</div>
    }
    else if (cart is null || cart.IsEmpty)
    {
        <div class="bg-bg-surface border border-white/5 rounded-2xl p-16 text-center">
            <i class="fa-solid fa-cart-shopping text-4xl text-text-muted mb-4"></i>
            <h2 class="text-xl font-bold mb-2">Your cart is empty</h2>
            <p class="text-text-secondary mb-6">Browse the catalog and add products to get started.</p>
            <a href="/products" class="inline-flex items-center gap-2 bg-gradient-to-r from-indigo-500 to-purple-500 text-white font-semibold text-sm py-3 px-6 rounded-xl hover:-translate-y-0.5 transition">
                <i class="fa-solid fa-arrow-left"></i> Continue shopping
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 bg-bg-surface border border-white/5 rounded-2xl p-6">
                <div class="flex justify-between items-center pb-4 mb-4 border-b border-white/5">
                    <div class="text-lg font-bold flex items-center gap-2">
                        Items in cart
                        <span class="bg-accent text-white text-xs font-bold px-2 py-0.5 rounded-full">@cart.Items.Count</span>
                    </div>
                    <button type="button"
                            class="text-danger text-sm hover:underline disabled:opacity-50"
                            disabled="@isBusy"
                            @onclick="ClearCart">
                        <i class="fa-solid fa-trash-can mr-1"></i> Clear all
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="bg-danger-bg border border-danger/30 text-danger text-sm rounded-lg px-4 py-3 mb-4">
                        @errorMessage
                    </div>
                }

                <div class="flex flex-col">
                    @foreach (var item in cart.Items)
                    {
                        <div class="flex items-center gap-5 py-5 border-b border-dashed border-white/5 last:border-b-0" @key="item.CartItemId">
                            <div class="w-20 h-20 shrink-0 rounded-lg bg-bg-card border border-white/5 flex items-center justify-center overflow-hidden">
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.ProductName" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <i class="fa-solid fa-image text-2xl text-text-muted"></i>
                                }
                            </div>

                            <div class="flex-1 min-w-0">
                                <a href="@($"/products/{item.Slug}")" class="font-bold text-text-primary hover:text-accent block truncate">@item.ProductName</a>
                                <div class="text-xs text-text-muted mt-1 flex flex-wrap gap-x-3 gap-y-1">
                                    @if (!string.IsNullOrWhiteSpace(item.VariantLabel))
                                    {
                                        <span>@item.VariantLabel</span>
                                    }
                                    <span>SKU: @item.Sku</span>
                                    @if (item.InStock)
                                    {
                                        <span class="text-emerald-400">In stock</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">Out of stock</span>
                                    }
                                </div>

                                <div class="inline-flex items-center bg-bg-base border border-white/5 rounded-lg overflow-hidden mt-3">
                                    <button type="button"
                                            class="w-8 h-8 flex items-center justify-center text-text-secondary hover:text-text-primary hover:bg-white/5 transition disabled:opacity-40"
                                            disabled="@isBusy"
                                            @onclick="@(() => ChangeQuantity(item, item.Quantity - 1))">
                                        <i class="fa-solid fa-minus text-xs"></i>
                                    </button>
                                    <span class="w-9 text-center text-sm font-semibold">@item.Quantity</span>
                                    <button type="button"
                                            class="w-8 h-8 flex items-center justify-center text-text-secondary hover:text-text-primary hover:bg-white/5 transition disabled:opacity-40"
                                            disabled="@(isBusy || item.Quantity >= item.StockQuantity)"
                                            @onclick="@(() => ChangeQuantity(item, item.Quantity + 1))">
                                        <i class="fa-solid fa-plus text-xs"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="flex flex-col items-end gap-3">
                                <div class="text-lg font-extrabold text-accent">@FormatPrice(item.LineTotal)</div>
                                <div class="text-xs text-text-muted">@FormatPrice(item.UnitPrice) each</div>
                                <button type="button"
                                        class="w-8 h-8 rounded-lg bg-danger-bg border border-danger/20 text-danger flex items-center justify-center hover:bg-danger hover:text-white transition disabled:opacity-40"
                                        disabled="@isBusy"
                                        @onclick="@(() => RemoveItem(item))">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div>
                <div class="bg-bg-surface border border-white/5 rounded-2xl p-6">
                    <div class="text-lg font-bold pb-4 mb-4 border-b border-white/5">Order Summary</div>

                    <div class="flex justify-between text-sm text-text-secondary mb-4">
                        <span>Subtotal (@cart.TotalQuantity items)</span>
                        <span class="text-text-primary font-medium">@FormatPrice(cart.Subtotal)</span>
                    </div>
                    <div class="flex justify-between text-sm text-text-secondary mb-4">
                        <span>Shipping</span>
                        <span class="text-text-primary font-medium">
                            @(cart.ShippingFee == 0 ? "Free" : FormatPrice(cart.ShippingFee))
                        </span>
                    </div>
                    <div class="flex justify-between text-sm text-text-secondary mb-4">
                        <span>VAT (8%)</span>
                        <span class="text-text-primary font-medium">@FormatPrice(cart.TaxAmount)</span>
                    </div>

                    <div class="flex gap-2 my-6">
                        <input type="text"
                               class="flex-1 bg-bg-base border border-white/5 rounded-lg py-3 px-4 text-sm text-text-primary opacity-60 cursor-not-allowed"
                               placeholder="Promo code (coming soon)"
                               disabled="@true" />
                        <button type="button"
                                class="bg-bg-card border border-white/5 text-text-primary px-4 rounded-lg text-sm font-semibold opacity-60 cursor-not-allowed"
                                disabled="@true">
                            Apply
                        </button>
                    </div>

                    <div class="flex justify-between items-center border-t border-dashed border-white/5 pt-5 mt-2">
                        <span class="text-base font-semibold">Total</span>
                        <span class="text-2xl font-extrabold text-accent">@FormatPrice(cart.Total)</span>
                    </div>

                    <button type="button"
                            class="w-full mt-6 py-4 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-500 text-white font-bold text-sm flex justify-center items-center gap-2 hover:-translate-y-0.5 transition disabled:opacity-60"
                            disabled="@(isBusy || cart.Items.Any(i => !i.InStock))">
                        Proceed to Checkout <i class="fa-solid fa-arrow-right"></i>
                    </button>

                    <a href="/products" class="block text-center text-text-secondary hover:text-text-primary text-sm mt-4">
                        <i class="fa-solid fa-arrow-left mr-1"></i> Continue shopping
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private CartDto? cart;
    private string? userId;
    private bool isLoading = true;
    private bool isBusy;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (!string.IsNullOrWhiteSpace(userId))
        {
            cart = await CartService.GetCartAsync(userId);
            CartState.SetCount(cart.TotalQuantity);
        }

        isLoading = false;
    }

    private async Task ChangeQuantity(CartLineDto item, int newQuantity)
    {
        if (isBusy || string.IsNullOrWhiteSpace(userId))
            return;

        await RunAsync(() => CartService.UpdateItemQuantityAsync(userId!, item.CartItemId, newQuantity));
    }

    private async Task RemoveItem(CartLineDto item)
    {
        if (isBusy || string.IsNullOrWhiteSpace(userId))
            return;

        await RunAsync(() => CartService.RemoveItemAsync(userId!, item.CartItemId));
    }

    private async Task ClearCart()
    {
        if (isBusy || string.IsNullOrWhiteSpace(userId))
            return;

        isBusy = true;
        errorMessage = null;

        var result = await CartService.ClearAsync(userId!);
        if (!result.Success)
            errorMessage = result.Error;

        cart = await CartService.GetCartAsync(userId!);
        CartState.SetCount(cart.TotalQuantity);
        isBusy = false;
    }

    private async Task RunAsync(Func<Task<Nexus.Services.Categories.Models.ServiceResult<CartDto>>> action)
    {
        isBusy = true;
        errorMessage = null;

        var result = await action();
        if (result.Success && result.Data is not null)
        {
            cart = result.Data;
            CartState.SetCount(cart.TotalQuantity);
        }
        else
        {
            errorMessage = result.Error;
            cart = await CartService.GetCartAsync(userId!);
            CartState.SetCount(cart.TotalQuantity);
        }

        isBusy = false;
    }

    private static string FormatPrice(decimal price) =>
        price.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) + " ₫";
}
