@page "/products/{Slug}"
@layout StorefrontLayout
@rendermode InteractiveServer

@using System.Security.Claims
@using Nexus.Components.Storefront.Shared
@using Nexus.Services.Cart
@using Nexus.Services.Cart.Models
@using Nexus.Services.Demo
@using Nexus.Services.Products
@using Nexus.Services.Products.Models

@inject IProductService ProductService
@inject ICartService CartService
@inject CartState CartState
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IDemoAddToCartCtaService DemoAddToCartCtaService

<PageTitle>@(product?.Name ?? "Product") — NEXUS</PageTitle>

@if (isLoading)
{
    <div class="max-w-7xl mx-auto px-6 py-16 text-text-muted">Loading product...</div>
}
else if (product is null)
{
    <div class="max-w-7xl mx-auto px-6 py-16 text-center">
        <h1 class="text-2xl font-bold mb-2">Product not found</h1>
        <p class="text-text-secondary mb-6">This product may be unavailable or no longer exists.</p>
        <a href="/products" class="text-accent font-semibold hover:underline" data-testid="pdp-back-to-shop">
            <i class="fa-solid fa-arrow-left mr-2"></i> Back to shop
        </a>
    </div>
}
else
{
    <div class="max-w-7xl mx-auto px-6 pt-4">
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3 flex items-center justify-between shadow-sm">
            <span class="text-sm font-bold text-yellow-800">
                <i class="fa-solid fa-wrench mr-2"></i> Demo Control: Đổi mã nguồn nút Add to cart
            </span>
            <select @bind="ActiveAddToCartCta" @bind:after="OnAddToCartCtaChanged"
                    class="bg-white border border-yellow-300 text-sm rounded px-3 py-1 outline-none focus:border-yellow-500">
                <option value="@AddToCartCtaVariant.Baseline">Bản gốc (Baseline)</option>
                <option value="@AddToCartCtaVariant.AttrAndCopy">Cấp 1: Đổi Text & TestID</option>
                <option value="@AddToCartCtaVariant.AnchorSemantics">Cấp 2: Đổi thẻ Button thành Anchor</option>
                <option value="@AddToCartCtaVariant.VietnameseSvg">Cấp 3: Giao diện tiếng Việt + SVG</option>
                <option value="@AddToCartCtaVariant.BossDecoy">Cấp 4: Cấu trúc phức tạp + Nút chim mồi</option>
            </select>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 py-10" data-testid="pdp-page" data-slug="@product.Slug">
        <a href="/products" class="text-text-secondary hover:text-text-primary text-sm mb-6 inline-block" data-testid="pdp-back-to-shop">
            <i class="fa-solid fa-arrow-left mr-2"></i> Back to shop
        </a>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
            <div class="lg:col-span-6">
                <ProductImageGallery ProductName="@product.Name"
                                     Images="@product.Images"
                                     VariantImageUrl="@resolvedVariant?.ImageUrl"
                                     InStock="@(resolvedVariant?.StockQuantity > 0)"
                                     ShowAvailability="@(resolvedVariant is not null)" />
            </div>

            <div class="lg:col-span-6 flex flex-col gap-6">
                <div class="space-y-2">
                    <span class="text-xs font-bold text-indigo-400 uppercase tracking-widest bg-indigo-500/10 py-1 px-3 rounded-full"
                          data-testid="pdp-category">
                        @product.CategoryName
                    </span>
                    <h1 class="text-3xl font-extrabold text-text-primary tracking-tight pt-1" data-testid="pdp-title">@product.Name</h1>
                    @if (!string.IsNullOrWhiteSpace(product.Description))
                    {
                        <p class="text-sm text-text-secondary leading-relaxed pt-2">@product.Description</p>
                    }
                </div>

                @if (product.Options.Count > 0)
                {
                    <ProductOptionPickers Options="@product.Options"
                                          SelectedValues="@selectedValues"
                                          SelectedValuesChanged="@OnSelectionChanged" />
                }

                <ProductVariantSummary ResolvedVariant="@resolvedVariant"
                                       PromptMessage="@promptMessage"
                                       IsInvalidCombination="@isInvalidCombination"
                                       Quantity="@quantity"
                                       QuantityChanged="@OnQuantityChanged"
                                       OnAddToCart="@AddToCart"
                                       IsAdding="@isAdding"
                                       StatusMessage="@cartMessage"
                                       IsError="@cartError"
                                       ActiveVariant="@ActiveAddToCartCta" />
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private AddToCartCtaVariant ActiveAddToCartCta { get; set; } = AddToCartCtaVariant.Baseline;

    private ProductDetailDto? product;
    private ProductVariantDto? resolvedVariant;
    private Dictionary<int, int> selectedValues = new();
    private string? promptMessage;
    private bool isInvalidCombination;
    private bool isLoading = true;
    private bool isAdding;
    private string? cartMessage;
    private bool cartError;
    private int quantity = 1;

    protected override async Task OnInitializedAsync()
    {
        ActiveAddToCartCta = await DemoAddToCartCtaService.GetAsync();
    }

    private async Task OnAddToCartCtaChanged()
    {
        await DemoAddToCartCtaService.SetAsync(ActiveAddToCartCta);
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        product = await ProductService.GetBySlugAsync(Slug);
        selectedValues = new Dictionary<int, int>();
        resolvedVariant = null;
        promptMessage = null;
        isInvalidCombination = false;
        quantity = 1;

        if (product is not null)
        {
            ApplyDefaultSelection();
            ResolveSelection();
            ClampQuantity();
        }

        isLoading = false;
    }

    private Task OnSelectionChanged(IReadOnlyDictionary<int, int> values)
    {
        selectedValues = new Dictionary<int, int>(values);
        cartMessage = null;
        cartError = false;
        ResolveSelection();
        ClampQuantity();
        return Task.CompletedTask;
    }

    private Task OnQuantityChanged(int value)
    {
        quantity = value;
        ClampQuantity();
        return Task.CompletedTask;
    }

    private async Task AddToCart()
    {
        if (resolvedVariant is null || isAdding)
            return;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrWhiteSpace(userId))
        {
            var returnUrl = Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri));
            Navigation.NavigateTo($"Account/Login?ReturnUrl=/{returnUrl}", forceLoad: true);
            return;
        }

        isAdding = true;
        cartMessage = null;
        cartError = false;

        var result = await CartService.AddItemAsync(userId, new AddToCartRequest(resolvedVariant.Id, quantity));

        if (result.Success && result.Data is not null)
        {
            cartError = false;
            cartMessage = "Added to cart.";
            CartState.SetCount(result.Data.TotalQuantity);
        }
        else
        {
            cartError = true;
            cartMessage = result.Error ?? "Could not add to cart.";
        }

        isAdding = false;
    }

    private void ResolveSelection()
    {
        if (product is null)
            return;

        promptMessage = null;
        isInvalidCombination = false;
        resolvedVariant = null;

        if (product.Options.Count == 0)
        {
            resolvedVariant = VariantResolutionHelper.SelectDefaultVariant(product.Variants);
            return;
        }

        var orderedOptions = product.Options.OrderBy(o => o.SortOrder).ThenBy(o => o.Id).ToList();

        foreach (var option in orderedOptions)
        {
            if (!selectedValues.ContainsKey(option.Id))
            {
                promptMessage = $"Select {option.Name}";
                return;
            }
        }

        var optionValueIds = orderedOptions
            .Select(o => selectedValues[o.Id])
            .ToList();

        if (!VariantResolutionHelper.IsValidSelection(product.Options, optionValueIds))
        {
            isInvalidCombination = true;
            return;
        }

        resolvedVariant = VariantResolutionHelper.ResolveFromVariants(
            product.Variants,
            optionValueIds,
            product.Options.Count);
        isInvalidCombination = resolvedVariant is null;
    }

    private void ApplyDefaultSelection()
    {
        if (product is null || product.Options.Count == 0)
            return;

        var defaultVariant = VariantResolutionHelper.SelectDefaultVariant(product.Variants);
        if (defaultVariant is null)
            return;

        selectedValues = VariantResolutionHelper.BuildSelectedValues(product.Options, defaultVariant);
    }

    private void ClampQuantity()
    {
        if (quantity < 1)
            quantity = 1;

        var stock = resolvedVariant?.StockQuantity ?? 0;
        if (stock <= 0)
        {
            quantity = 1;
            return;
        }

        if (quantity > stock)
            quantity = stock;
    }
}
