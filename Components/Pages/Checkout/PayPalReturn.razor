@page "/checkout/paypal/return"
@layout StorefrontLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Nexus.Data
@using Nexus.Services.Cart
@using Nexus.Services.Orders

@attribute [Authorize(Roles = IdentitySeedData.CustomerRole)]

@inject IOrderService OrderService
@inject CartState CartState
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Confirming payment — NEXUS</PageTitle>

<div class="max-w-2xl mx-auto px-6 py-16">
    @if (isProcessing)
    {
        <div class="bg-bg-surface border border-white/5 rounded-2xl p-12 text-center">
            <i class="fa-solid fa-spinner fa-spin text-3xl text-accent mb-4"></i>
            <h1 class="text-xl font-bold mb-2">Confirming your payment...</h1>
            <p class="text-text-secondary text-sm">Please wait while we finalize your order.</p>
        </div>
    }
    else
    {
        <div class="bg-bg-surface border border-danger/30 rounded-2xl p-12 text-center">
            <i class="fa-solid fa-circle-exclamation text-3xl text-danger mb-4"></i>
            <h1 class="text-xl font-bold mb-2">We couldn't confirm your payment</h1>
            <p class="text-text-secondary text-sm mb-6">@errorMessage</p>
            <a href="/cart" class="inline-flex items-center gap-2 bg-gradient-to-r from-indigo-500 to-purple-500 text-white font-semibold text-sm py-3 px-6 rounded-xl hover:-translate-y-0.5 transition">
                <i class="fa-solid fa-arrow-left"></i> Back to cart
            </a>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private bool isProcessing = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            isProcessing = false;
            errorMessage = "Missing PayPal reference.";
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrWhiteSpace(userId))
        {
            isProcessing = false;
            errorMessage = "You must be signed in to confirm this payment.";
            return;
        }

        var result = await OrderService.CompletePayPalPaymentAsync(userId, Token);

        if (result.Success && result.Data is not null)
        {
            CartState.SetCount(0);
            Navigation.NavigateTo($"/orders/{result.Data.OrderNumber}");
            return;
        }

        isProcessing = false;
        errorMessage = result.Error ?? "Your payment could not be completed. You can try again from your cart.";
    }
}
