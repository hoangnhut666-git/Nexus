@page "/checkout"
@layout StorefrontLayout
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Nexus.Data
@using Nexus.Data.Entities
@using Nexus.Services.Addresses
@using Nexus.Services.Addresses.Models
@using Nexus.Services.Cart
@using Nexus.Services.Cart.Models
@using Nexus.Services.Orders
@using Nexus.Services.Orders.Models

@attribute [Authorize(Roles = IdentitySeedData.CustomerRole)]

@inject ICartService CartService
@inject IOrderService OrderService
@inject IAddressService AddressService
@inject IVietnamAddressUnitService AddressUnits
@inject CartState CartState
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Checkout — NEXUS</PageTitle>

<div class="max-w-7xl mx-auto px-6 py-10" data-testid="checkout-page">
    <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight mb-2">Checkout</h1>
        <p class="text-text-secondary text-sm">Enter your shipping details and place your order</p>
    </div>

    @if (isLoading)
    {
        <div class="text-text-muted py-16">Loading checkout...</div>
    }
    else if (cart is null || cart.IsEmpty)
    {
        <div class="text-text-muted py-16">Your cart is empty. Redirecting...</div>
    }
    else
    {
        <EditForm Model="form" OnValidSubmit="PlaceOrder" data-testid="checkout-form">
            <DataAnnotationsValidator />

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-2 flex flex-col gap-6">
                    <div class="bg-bg-surface border border-border rounded-2xl p-6">
                        <div class="flex items-center justify-between pb-4 mb-4 border-b border-border">
                            <div class="text-lg font-bold">Shipping Address</div>
                            @if (savedAddresses.Count > 0 && !useNewAddress)
                            {
                                <button type="button" @onclick="StartNewAddress"
                                        data-testid="checkout-use-new-address"
                                        class="text-xs font-bold text-indigo-400 hover:text-indigo-300 transition-colors">
                                    <i class="fa-solid fa-plus mr-1 text-[10px]"></i> Use a new address
                                </button>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="bg-danger-bg border border-danger/30 text-danger text-sm rounded-lg px-4 py-3 mb-4">
                                @errorMessage
                            </div>
                        }

                        @if (savedAddresses.Count > 0 && !useNewAddress)
                        {
                            <div class="flex flex-col gap-3">
                                @foreach (var address in savedAddresses)
                                {
                                    <label class="flex items-start gap-3 p-4 rounded-xl border cursor-pointer @(selectedAddressId == address.Id ? "border-indigo-500/40 bg-indigo-500/5" : "border-border")"
                                           @key="address.Id">
                                        <input type="radio" name="saved-address" class="mt-1"
                                               data-testid="checkout-saved-address"
                                               data-name="@address.RecipientName"
                                               checked="@(selectedAddressId == address.Id)"
                                               @onchange="@(() => SelectAddress(address))" />
                                        <span class="flex-1 min-w-0">
                                            <span class="flex items-center gap-2 flex-wrap">
                                                <span class="font-semibold">@address.RecipientName</span>
                                                @if (!string.IsNullOrWhiteSpace(address.Label))
                                                {
                                                    <span class="text-[10px] uppercase tracking-wider font-bold text-text-secondary bg-overlay px-2 py-0.5 rounded-full">@address.Label</span>
                                                }
                                                @if (address.IsDefault)
                                                {
                                                    <span class="text-[10px] uppercase tracking-wider font-bold text-success bg-success/10 px-2 py-0.5 rounded-full">Default</span>
                                                }
                                            </span>
                                            <span class="block text-xs text-text-muted mt-0.5">@address.Phone</span>
                                            <span class="block text-xs text-text-secondary">@AddressFormatter.OneLine(address)</span>
                                        </span>
                                    </label>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="flex flex-col gap-2 md:col-span-2">
                                    <label class="text-[11px] font-bold text-text-secondary uppercase tracking-wider">Recipient Name *</label>
                                    <InputText @bind-Value="form.RecipientName" class="@InputClass" placeholder="Nguyễn Văn A" data-testid="checkout-recipient-input" />
                                    <ValidationMessage For="() => form.RecipientName" class="text-danger text-xs" />
                                </div>

                                <div class="flex flex-col gap-2">
                                    <label class="text-[11px] font-bold text-text-secondary uppercase tracking-wider">Phone *</label>
                                    <InputText @bind-Value="form.Phone" class="@InputClass" placeholder="0901234567" data-testid="checkout-phone-input" />
                                    <ValidationMessage For="() => form.Phone" class="text-danger text-xs" />
                                </div>

                                <div class="flex flex-col gap-2 md:col-span-2">
                                    <label class="text-[11px] font-bold text-text-secondary uppercase tracking-wider">Street Address / Detail *</label>
                                    <InputText @bind-Value="form.AddressLine" class="@InputClass" placeholder="No. 25, Nguyễn Trãi Street" data-testid="checkout-address-input" />
                                    <ValidationMessage For="() => form.AddressLine" class="text-danger text-xs" />
                                </div>

                                <div class="flex flex-col gap-2">
                                    <label class="text-[11px] font-bold text-text-secondary uppercase tracking-wider">Province / City *</label>
                                    <select value="@form.Province" @onchange="OnProvinceChanged" class="@InputClass" data-testid="checkout-province-select">
                                        <option value="">-- Select province / city --</option>
                                        @foreach (var province in provinces)
                                        {
                                            <option value="@province">@province</option>
                                        }
                                    </select>
                                    <ValidationMessage For="() => form.Province" class="text-danger text-xs" />
                                </div>

                                <div class="flex flex-col gap-2">
                                    <label class="text-[11px] font-bold text-text-secondary uppercase tracking-wider">Ward / Commune *</label>
                                    <select value="@form.Ward" @onchange="OnWardChanged" class="@InputClass" disabled="@(wardOptions.Count == 0)" data-testid="checkout-ward-select">
                                        <option value="">@(wardOptions.Count == 0 ? "-- Select a province first --" : "-- Select ward / commune --")</option>
                                        @foreach (var ward in wardOptions)
                                        {
                                            <option value="@ward">@ward</option>
                                        }
                                    </select>
                                    <ValidationMessage For="() => form.Ward" class="text-danger text-xs" />
                                </div>

                                <label class="flex items-center gap-2.5 text-sm text-text-secondary cursor-pointer select-none md:col-span-2 mt-1">
                                    <InputCheckbox @bind-Value="saveNewAddress" class="custom-checkbox" data-testid="checkout-save-address" />
                                    Save this address to my account
                                </label>

                                @if (savedAddresses.Count > 0)
                                {
                                    <button type="button" @onclick="UseSavedAddresses"
                                            class="text-xs font-bold text-text-secondary hover:text-text-primary transition-colors text-left md:col-span-2">
                                        <i class="fa-solid fa-arrow-left mr-1 text-[10px]"></i> Choose a saved address instead
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <div class="bg-bg-surface border border-border rounded-2xl p-6">
                        <div class="text-lg font-bold pb-4 mb-4 border-b border-border">Payment Method</div>

                        <label class="flex items-center gap-3 p-4 rounded-xl border cursor-pointer @(form.Method == PaymentMethod.Cod ? "border-indigo-500/40 bg-indigo-500/5" : "border-border")">
                            <input type="radio" name="payment" checked="@(form.Method == PaymentMethod.Cod)"
                                   data-testid="checkout-payment-cod"
                                   @onchange="@(() => form.Method = PaymentMethod.Cod)" />
                            <span class="flex-1">
                                <span class="font-semibold block">Cash on Delivery</span>
                                <span class="text-xs text-text-muted">Pay with cash when your order arrives</span>
                            </span>
                            <i class="fa-solid fa-money-bill-wave text-accent"></i>
                        </label>

                        <label class="flex items-center gap-3 p-4 rounded-xl border mt-3 cursor-pointer @(form.Method == PaymentMethod.PayPal ? "border-indigo-500/40 bg-indigo-500/5" : "border-border")">
                            <input type="radio" name="payment" checked="@(form.Method == PaymentMethod.PayPal)"
                                   data-testid="checkout-payment-paypal"
                                   @onchange="@(() => form.Method = PaymentMethod.PayPal)" />
                            <span class="flex-1">
                                <span class="font-semibold block">PayPal</span>
                                <span class="text-xs text-text-muted">Pay securely with your PayPal account</span>
                            </span>
                            <i class="fa-brands fa-paypal text-sky-400"></i>
                        </label>
                    </div>
                </div>

                <div>
                    <div class="bg-bg-surface border border-border rounded-2xl p-6">
                        <div class="text-lg font-bold pb-4 mb-4 border-b border-border">Order Summary</div>

                        <div class="flex flex-col gap-3 mb-4">
                            @foreach (var item in cart.Items)
                            {
                                <div class="flex justify-between text-sm" @key="item.CartItemId">
                                    <span class="text-text-secondary truncate mr-2">
                                        @item.ProductName
                                        <span class="text-text-muted">x@item.Quantity</span>
                                    </span>
                                    <span class="text-text-primary font-medium whitespace-nowrap">@MoneyFormatter.Format(item.LineTotal)</span>
                                </div>
                            }
                        </div>

                        <div class="border-t border-border pt-4">
                            <div class="flex justify-between text-sm text-text-secondary mb-4">
                                <span>Subtotal (@cart.TotalQuantity items)</span>
                                <span class="text-text-primary font-medium">@MoneyFormatter.Format(cart.Subtotal)</span>
                            </div>
                            <div class="flex justify-between text-sm text-text-secondary mb-4">
                                <span>Shipping</span>
                                <span class="text-text-primary font-medium">
                                    @(cart.ShippingFee == 0 ? "Free" : MoneyFormatter.Format(cart.ShippingFee))
                                </span>
                            </div>
                            <div class="flex justify-between text-sm text-text-secondary mb-4">
                                <span>VAT (8%)</span>
                                <span class="text-text-primary font-medium">@MoneyFormatter.Format(cart.TaxAmount)</span>
                            </div>
                        </div>

                        <div class="flex justify-between items-center border-t border-dashed border-border pt-5 mt-2">
                            <span class="text-base font-semibold">Total</span>
                            <span class="text-2xl font-extrabold text-accent">@MoneyFormatter.Format(cart.Total)</span>
                        </div>

                        <button type="submit"
                                class="w-full mt-6 py-4 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-500 text-white font-bold text-sm flex justify-center items-center gap-2 hover:-translate-y-0.5 transition disabled:opacity-60"
                                disabled="@(isSubmitting || cart.Items.Any(i => !i.InStock))"
                                data-testid="checkout-place-order-button">
                            @if (isSubmitting)
                            {
                                <span>Placing order...</span>
                            }
                            else
                            {
                                <span>Place Order</span>
                                <i class="fa-solid fa-lock"></i>
                            }
                        </button>

                        <a href="/cart" class="block text-center text-text-secondary hover:text-text-primary text-sm mt-4" data-testid="checkout-back-to-cart">
                            <i class="fa-solid fa-arrow-left mr-1"></i> Back to cart
                        </a>
                    </div>
                </div>
            </div>
        </EditForm>
    }
</div>

@code {
    private const string InputClass = "bg-bg-base border border-border rounded-lg py-3 px-4 text-sm text-text-primary focus:outline-none focus:border-indigo-500/40 w-full";

    private CartDto? cart;
    private string? userId;
    private bool isLoading = true;
    private bool isSubmitting;
    private string? errorMessage;

    private IReadOnlyList<AddressDto> savedAddresses = [];
    private int? selectedAddressId;
    private bool useNewAddress;
    private bool saveNewAddress = true;
    private string? profileFullName;

    private IReadOnlyList<string> provinces = [];
    private List<string> wardOptions = [];

    private readonly CheckoutFormModel form = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrWhiteSpace(userId))
        {
            isLoading = false;
            return;
        }

        cart = await CartService.GetCartAsync(userId);
        CartState.SetCount(cart.TotalQuantity);

        if (cart.IsEmpty)
        {
            isLoading = false;
            Navigation.NavigateTo("/cart");
            return;
        }

        var appUser = await UserManager.GetUserAsync(authState.User);
        profileFullName = appUser?.FullName;

        provinces = AddressUnits.GetProvinces();
        savedAddresses = await AddressService.GetAddressesAsync(userId);

        if (savedAddresses.Count > 0)
        {
            var initial = savedAddresses.FirstOrDefault(a => a.IsDefault) ?? savedAddresses[0];
            SelectAddress(initial);
        }
        else
        {
            useNewAddress = true;
            if (!string.IsNullOrWhiteSpace(profileFullName))
                form.RecipientName = profileFullName;
        }

        isLoading = false;
    }

    private void OnProvinceChanged(ChangeEventArgs e)
    {
        form.Province = e.Value?.ToString() ?? string.Empty;
        wardOptions = AddressUnits.GetWards(form.Province).ToList();
        form.Ward = string.Empty;
    }

    private void OnWardChanged(ChangeEventArgs e)
    {
        form.Ward = e.Value?.ToString() ?? string.Empty;
    }

    private void SelectAddress(AddressDto address)
    {
        selectedAddressId = address.Id;
        useNewAddress = false;
        ApplyAddress(address);
    }

    private void UseSavedAddresses()
    {
        useNewAddress = false;
        var current = savedAddresses.FirstOrDefault(a => a.Id == selectedAddressId)
                      ?? savedAddresses.FirstOrDefault(a => a.IsDefault)
                      ?? savedAddresses.FirstOrDefault();
        if (current is not null)
            SelectAddress(current);
    }

    private void StartNewAddress()
    {
        useNewAddress = true;
        selectedAddressId = null;
        saveNewAddress = true;
        form.RecipientName = profileFullName ?? string.Empty;
        form.Phone = string.Empty;
        form.AddressLine = string.Empty;
        form.Ward = string.Empty;
        form.Province = string.Empty;
        form.Country = "Vietnam";
        wardOptions = [];
    }

    private void ApplyAddress(AddressDto a)
    {
        form.RecipientName = a.RecipientName;
        form.Phone = a.Phone;
        form.AddressLine = a.AddressLine;
        form.Ward = a.Ward;
        form.Province = a.Province;
        form.Country = string.IsNullOrWhiteSpace(a.Country) ? "Vietnam" : a.Country;
    }

    private async Task PlaceOrder()
    {
        if (isSubmitting || string.IsNullOrWhiteSpace(userId))
            return;

        isSubmitting = true;
        errorMessage = null;

        if (useNewAddress && !AddressUnits.IsValid(form.Province, form.Ward))
        {
            errorMessage = "Please choose a valid province and ward from the list.";
            isSubmitting = false;
            return;
        }

        if (useNewAddress && saveNewAddress)
        {
            var saveResult = await AddressService.AddAsync(userId, new AddressInput
            {
                RecipientName = form.RecipientName,
                Phone = form.Phone,
                AddressLine = form.AddressLine,
                Ward = form.Ward,
                Province = form.Province,
                Country = "Vietnam",
                SetAsDefault = savedAddresses.Count == 0
            });

            if (!saveResult.Success)
            {
                errorMessage = saveResult.Error ?? "We couldn't save your address. Please try again.";
                isSubmitting = false;
                return;
            }
        }

        var request = new CheckoutRequest
        {
            ShipFullName = form.RecipientName,
            ShipPhone = form.Phone,
            ShipStreet = form.AddressLine,
            ShipCity = form.Province,
            ShipState = form.Ward,
            ShipPostalCode = null,
            ShipCountry = form.Country,
            Method = form.Method,
            ReturnUrlBase = Navigation.BaseUri
        };

        var result = await OrderService.CreateOrderFromCartAsync(userId, request);

        if (result.Success && result.Data is not null)
        {
            if (!string.IsNullOrWhiteSpace(result.Data.RedirectUrl))
            {
                // PayPal: hand off to the approval page (full navigation).
                Navigation.NavigateTo(result.Data.RedirectUrl, forceLoad: true);
                return;
            }

            CartState.SetCount(0);
            Navigation.NavigateTo($"/orders/{result.Data.OrderNumber}");
            return;
        }

        errorMessage = result.Error ?? "We couldn't place your order. Please try again.";
        cart = await CartService.GetCartAsync(userId);
        CartState.SetCount(cart.TotalQuantity);

        if (cart.IsEmpty)
            Navigation.NavigateTo("/cart");

        isSubmitting = false;
    }

    private sealed class CheckoutFormModel
    {
        [Required(ErrorMessage = "Recipient name is required.")]
        public string RecipientName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Phone is required.")]
        public string Phone { get; set; } = string.Empty;

        [Required(ErrorMessage = "Street address is required.")]
        public string AddressLine { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ward / commune is required.")]
        public string Ward { get; set; } = string.Empty;

        [Required(ErrorMessage = "Province / city is required.")]
        public string Province { get; set; } = string.Empty;

        public string Country { get; set; } = "Vietnam";

        public PaymentMethod Method { get; set; } = PaymentMethod.Cod;
    }
}
