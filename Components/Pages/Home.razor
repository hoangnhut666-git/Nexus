@page "/"
@layout StorefrontLayout
@rendermode InteractiveServer

@using Nexus.Services.Categories
@using Nexus.Services.Categories.Models
@using Nexus.Services.Products
@using Nexus.Services.Products.Models

@inject ICategoryService CategoryService
@inject IProductService ProductService

<PageTitle>NEXUS // Premium E-Commerce</PageTitle>

<HeroSection />
<CategoryGrid Categories="categories" />
<ProductGrid Products="products" />
<PromoBanner />
<FeaturesSection />
<NewsletterSection />

@code {
    private IReadOnlyList<CategoryListItemDto> categories = [];
    private IReadOnlyList<CatalogProductListItemDto> products = [];

    protected override async Task OnInitializedAsync()
    {
        var categoryResult = await CategoryService.GetPagedAsync(new CategoryQuery
        {
            Status = CategoryStatusFilter.Active,
            Page = 1,
            PageSize = 4
        });

        var productResult = await ProductService.GetCatalogPagedAsync(new CatalogProductQuery
        {
            Page = 1,
            PageSize = 8
        });

        categories = categoryResult.Items;
        products = productResult.Items;
    }
}
